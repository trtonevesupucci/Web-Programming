<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" verbose="true" stopOnFailure="false">
    <testsuites>
        <testsuite name="FlightPHP REST API Test Suite">
            <directory>./tests</directory>
        </testsuite>
    </testsuites>
    
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./routes</directory>
            <directory suffix=".php">./services</directory>
            <directory suffix=".php">./dao</directory>
        </include>
    </coverage>
</phpunit>
